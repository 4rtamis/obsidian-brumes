{
	"name": "obsidian-brumes",
	"version": "2.0.0",
	"description": "An Obsidian plugin that brings themes and tools based on City of Mist, the award-winning modern fantasy tabletop role-playing game.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs --watch",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"city of mist",
		"legend in the mist",
		"ttrpg",
		"roleplaying",
		"game"
	],
	"author": "4rtamis",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "^6.38.1",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^16.18.126",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"autoprefixer": "^10.5.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.20.1",
		"esbuild-sass-plugin": "3.1.0",
		"obsidian": "^1.12.3",
		"sass": "^1.89.2",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
